# Copy to .env and fill with your Supabase values.
# Never commit .env. Set the same keys in Netlify → Site settings → Environment variables.

VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=your_anon_key_here

# Email sending (confirmation/invite/offer) goes through the Supabase Edge Function
# at supabase/functions/send-email, NOT through this .env file — a Resend API key must
# never be VITE_-prefixed, since VITE_ vars get inlined into the public client bundle.
# Configure it as an Edge Function secret instead:
#   npx supabase functions deploy send-email
#   npx supabase secrets set RESEND_API_KEY=re_xxx MAIL_FROM="Assessment Team <you@yourdomain.com>"
